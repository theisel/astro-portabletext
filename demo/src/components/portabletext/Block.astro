---
import type { BlockProps } from "astro-portabletext/types";
import { usePortableText } from "astro-portabletext";
import FancyBorder from "../FancyBorder.astro";

export type Props = BlockProps;

const props = Astro.props;
const { getDefaultComponent } = usePortableText(props.node);
const styleIs = (style: string) => style === props.node.style;
const Cmp = styleIs("fancyBorder") ? FancyBorder : getDefaultComponent();
---

<Cmp {...props}><slot /></Cmp>

<style>
  h1 {
    color: salmon;
  }
  h2 {
    color: olivedrab;
  }
  h3 {
    color: blueviolet;
  }
  blockquote {
    border-left: 0.5rem solid #ccc;
    margin-left: 0;
    margin-right: 2rem;
    padding-left: 2rem;
  }
</style>
