---
import type { BlockProps } from "astro-portabletext/types";
import { usePortableText } from "astro-portabletext";

export type Props = BlockProps;

const props = Astro.props;
const { node } = props;

const { render } = usePortableText(node);
---

<div data-custom="block">
  {
    render({
      text: ({ props }) => <span data-custom="text">{props.node.text} 🚀</span>,
    })
  }
</div>
