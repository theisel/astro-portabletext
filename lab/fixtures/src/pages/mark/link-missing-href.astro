---
import { PortableText } from "astro-portabletext";
import Layout from "@/layouts/Default.astro";

const blocks = [
  {
    _type: "block",
    children: [
      {
        _type: "span",
        text: "test.com",
        marks: ["link-key"],
      },
    ],
    markDefs: [
      {
        _key: "link-key",
        _type: "link",
      },
    ],
  },
];
---

<Layout>
  <PortableText value={blocks} />
</Layout>
