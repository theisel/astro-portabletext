{
  "name": "lab",
  "description": "Laboratory for testing `astro-portabletext`",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "author": "Tom Theisel <tom.theisel@gmail.com>",
  "license": "ISC",
  "scripts": {
    "build:fixture": "astro build --root fixtures --silent",
    "check": "astro check --root fixtures",
    "test:component": "pnpm build:fixture && vitest run tests/integration",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:ci": "pnpm --filter astro-portabletext check && pnpm check && pnpm test:unit && pnpm test:component",
    "test": "pnpm test:ci"
  },
  "dependencies": {
    "astro-portabletext": "workspace:*"
  },
  "devDependencies": {
    "cheerio": "1.2.0",
    "vitest": "^4.1.10"
  }
}
